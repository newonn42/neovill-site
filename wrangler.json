{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niovill",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "niovill-db",
      "database_id": "7d2a5c1e-3b4f-4e8a-9c6d-1f0e2b3a4c5d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
